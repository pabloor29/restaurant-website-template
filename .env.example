# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Supabase (shared restaurant-admin project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# UUID of this restaurant's row in the `restaurants` table.
RESTAURANT_ID=

# Email (Resend) — reservation confirmation + owner notification + autoreply.
RESEND_API_KEY=
# Verified sender address, e.g. reservations@your-restaurant.fr
RESEND_FROM_EMAIL=

# Public site URL (used for canonical/hreflang/OpenGraph/sitemap).
NEXT_PUBLIC_SITE_URL=https://www.your-restaurant.fr
# Show the phone number on the public site (footer, contact, call buttons).
# Transactional emails always include it regardless of this flag.
NEXT_PUBLIC_SHOW_PHONE=false

# ── Optional display overrides (defaults live in src/config/site.ts) ──
NEXT_PUBLIC_INSTAGRAM_HANDLE=@your_restaurant
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your_restaurant
# Paste a Google Maps "embed" iframe src; leave empty to build one from the
# restaurant address stored in Supabase.
NEXT_PUBLIC_MAPS_EMBED_SRC=
NEXT_PUBLIC_MAPS_PLACE_URL=
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=
